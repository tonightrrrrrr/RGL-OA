# 统一换行符：仓库里一律 LF；Windows 脚本检出为 CRLF，shell 脚本保持 LF
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh text eol=lf
# 二进制文件
*.png binary
*.ico binary
*.jpg binary
*.pdf binary
*.docx binary
*.xlsx binary
*.doc binary
*.xls binary
*.jar binary
*.zip binary
*.onnx binary
# OCR 模型的字典：一行一个字，按原样提交，不做换行转换
src/main/resources/ocr-models/**/*.txt -text
